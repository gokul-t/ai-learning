# Project Environment Configuration

# --- Hardware / ROCm / AMD GPU Settings ---
# Required for AMD GPU support in PyTorch/ROCm
HSA_OVERRIDE_GFX_VERSION=11.0.0
HIP_VISIBLE_DEVICES=0
MIOPEN_DEBUG_CONV_IMMED_FIND=0
MIOPEN_DEBUG_DISABLE_ASM_KERNELS=1

# --- uv / System Temp Settings ---
# Redirects large temp files to a dedicated disk location to avoid /tmp overflow
TMPDIR="/home/gokult/uv_large_tmp"
TEMP="/home/gokult/uv_large_tmp"
TMP="/home/gokult/uv_large_tmp"
UV_CACHE_DIR="/home/gokult/uv_large_tmp/cache"

# --- LLM Settings ---
OLLAMA_HOST=http://localhost:11434
DEFAULT_MODEL=qwen3.5:0.8b

# --- Hardware Settings ---
DEVICE=cuda
